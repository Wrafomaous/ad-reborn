        BorderSizePixel = 0,
        Position = udim2(0, -2, 0, -2),
        Size = udim2(0, 5, 0, 17),
        Image = "rbxassetid://14248606745",
        ZIndex = 13
    })

    local alphaBtn = new("TextButton", {
        Name = "TransparencyButton",
        Parent = alphaBg2,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = udim2(1, 0, 1, 0),
        Text = "",
        ZIndex = 13
    })

    for _, obj in pairs(content:GetDescendants()) do
        if not obj:IsA("UIGradient") and obj.ZIndex then
            obj.ZIndex = 13
        end
    end

    local pickerAPI = {}

    function pickerAPI:Open()
        content.Visible = true
        inline.Visible = true
        content.BackgroundTransparency = 0
        pickerAPI:FadeIn()
    end

    function pickerAPI:FadeIn()
        for _, obj in pairs(content:GetDescendants()) do
            if obj:IsA("Frame") then
                TweenService:Create(obj, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
            elseif obj:IsA("ImageLabel") then
                TweenService:Create(obj, TweenInfo.new(0.15), { ImageTransparency = 0 }):Play()
            end
        end
    end

    function pickerAPI:FadeOut()
        for _, obj in pairs(content:GetDescendants()) do
            if obj:IsA("Frame") then
                TweenService:Create(obj, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
            elseif obj:IsA("ImageLabel") then
                TweenService:Create(obj, TweenInfo.new(0.15), { ImageTransparency = 1 }):Play()
            end
        end
    end

    function pickerAPI:Close()
        TweenService:Create(content, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
        pickerAPI:FadeOut()
        task.wait(0.15)
        content.Visible = false
        inline.Visible = false
    end

    function self:Set(value, transparency, skipUpdate)
        transparency = transparency or inner.TransparencyValue or 0

        local alpha, finalColor
        if typeof(value) == "table" then
            local hexColor = Color3.fromHex(value[1])
            if value[2] == nil then
                alpha = transparency
                finalColor = hexColor
            else
                alpha = value[2]
                finalColor = hexColor
            end
        else
            alpha = transparency
            finalColor = value
        end

        local h, s, v = finalColor:ToHSV()
        inner.ColorValue = finalColor
        inner.TransparencyValue = alpha
        inner.HuePosition = h
        inner.Saturation = s
        inner.Value = v
        hueBg.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        status.BackgroundColor3 = finalColor
        status.BackgroundTransparency = 1 - alpha

        if not skipUpdate then
            local yPos = satBg.AbsoluteSize.Y - v * satBg.AbsoluteSize.Y
            satPicker.Position = udim2(0, math.clamp(s * satBg.AbsoluteSize.X, 0, satBg.AbsoluteSize.X - 3), 0, math.clamp(yPos, 0, satBg.AbsoluteSize.Y - 3))
            huePicker.Position = udim2(0, -4, 1 - h, -2)
            alphaPicker.Position = udim2(math.clamp(alpha, 0, 1), -2, 0, -2)
        end

        pcall(self.Callback, Color3.fromRGB(finalColor.R * 255, finalColor.G * 255, finalColor.B * 255), alpha)
        State.Flags[self.Flag] = {
            Color3.fromRGB(finalColor.R * 255, finalColor.G * 255, finalColor.B * 255):ToHex(),
            alpha
        }
    end

    self:Set(self.Default, self.Transparency)

    local function updateSaturation(input)
        local xRatio = math.clamp((input.Position.X - satBg.AbsolutePosition.X) / satBg.AbsoluteSize.X, 0, 1)
        local yRatio = 1 - math.clamp((input.Position.Y - satBg.AbsolutePosition.Y) / satBg.AbsoluteSize.Y, 0, 1)
        local yClamp = math.clamp((input.Position.Y - satBg.AbsolutePosition.Y) / satBg.AbsoluteSize.Y * satBg.AbsoluteSize.Y, 0, satBg.AbsoluteSize.Y - 3)
        satPicker.Position = udim2(0, math.clamp((input.Position.X - satBg.AbsolutePosition.X) / satBg.AbsoluteSize.X * satBg.AbsoluteSize.X, 0, satBg.AbsoluteSize.X - 4), 0, yClamp)
        self:Set(Color3.fromHSV(inner.HuePosition, xRatio, yRatio), inner.TransparencyValue, true)
    end

    satBtn.MouseButton1Down:Connect(function()
        inner.SlidingSat = true
        updateSaturation({ Position = UserInputService:GetMouseLocation() - Vector2.new(0, 36) })
    end)

    local function updateHue(input)
        local yRatio = 1 - math.clamp((input.Position.Y - hueBg.AbsolutePosition.Y) / hueBg.AbsoluteSize.Y, 0, 1)
        huePicker.Position = udim2(0, -4, 0, math.clamp((input.Position.Y - hueBg.AbsolutePosition.Y) / hueBg.AbsoluteSize.Y * hueBg.AbsoluteSize.Y, 0, hueBg.AbsoluteSize.Y - 2) - 2)
        inner.HuePosition = yRatio
        self:Set(Color3.fromHSV(yRatio, inner.Saturation, inner.Value), inner.TransparencyValue, true)
    end

    huePicker.MouseButton1Down:Connect(function()
        inner.SlidingHue = true
        updateHue({ Position = UserInputService:GetMouseLocation() - Vector2.new(0, 36) })
    end)

    local function updateAlpha(input)
        local xRatio = 1 - math.clamp((input.Position.X - alphaBg2.AbsolutePosition.X) / alphaBg2.AbsoluteSize.X, 0, 1)
        alphaPicker.Position = udim2(0, math.clamp((input.Position.X - alphaBg2.AbsolutePosition.X) / alphaBg2.AbsoluteSize.X * alphaBg2.AbsoluteSize.X, 0, alphaBg2.AbsoluteSize.X - 3), 0, -2)
        self:Set(Color3.fromHSV(inner.HuePosition, inner.Saturation, inner.Value), xRatio, true)
    end

    alphaBtn.MouseButton1Down:Connect(function()
        inner.SlidingAlpha = true
        updateAlpha({ Position = UserInputService:GetMouseLocation() - Vector2.new(0, 36) })
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            inner.SlidingSat = false
            inner.SlidingHue = false
            inner.SlidingAlpha = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            if inner.SlidingSat then
                updateSaturation(input)
            elseif inner.SlidingHue then
                updateHue(input)
            elseif inner.SlidingAlpha then
                updateAlpha(input)
            end
        end
    end)

    openBtn.MouseButton1Click:Connect(function()
        if State.Popup and State.Popup.ID ~= holder.Name then
            removePopups()
        end
        if inline.Visible then
            pickerAPI:Close()
        else
            newPopup({ Remove = pickerAPI.Close, ID = holder.Name })
            pickerAPI:Open()
        end
    end)

    State.ConfigFlags[self.Flag] = function(value)
        self:Set(value)
    end

    self.Instance = holder
    self.Inner = inner
    self.PickerAPI = pickerAPI
    self.Parent = parent
    return self
end

