local function getTextBoundary(text, font, size)
    local bounds = TextService:GetTextSize(text, size, font, Vector2.new(1920, 1080))
    return bounds.X, bounds.Y
end

local FlagCounter = 0
local function getNextFlag()
    FlagCounter += 1
    return tostring(FlagCounter)
end

local function fadeIn(container)
    for _, obj in pairs(container:GetDescendants()) do
        if obj:IsA("Frame") then
            TweenService:Create(obj, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
        elseif obj:IsA("ImageLabel") then
            TweenService:Create(obj, TweenInfo.new(0.15), { ImageTransparency = 0 }):Play()
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
            TweenService:Create(obj, TweenInfo.new(0.15), { TextTransparency = 0 }):Play()
        end
    end
end

local function fadeOut(container)
    for _, obj in pairs(container:GetDescendants()) do
        if obj:IsA("Frame") then
            TweenService:Create(obj, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
        elseif obj:IsA("ImageLabel") then
            TweenService:Create(obj, TweenInfo.new(0.15), { ImageTransparency = 1 }):Play()
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
            TweenService:Create(obj, TweenInfo.new(0.15), { TextTransparency = 1 }):Play()
        end
    end
end

local function removePopups()
    if State.Popup then
        State.Popup:Remove()
        State.Popup = nil
    end
end

local function newPopup(data)
    State.Popup = {
        Remove = data.Remove,
        ID = data.ID
    }
end

local function removePopupsChecked(id)
    if State.Popup and State.Popup.ID ~= id then
        removePopups()
    end
end

