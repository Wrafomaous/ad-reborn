        ZIndex = 3
    })

    new("UIListLayout", {
        Name = "KBContent",
        Parent = content,
        SortOrder = Enum.SortOrder.LayoutOrder
    })

    local pickerAPI = {}

    function pickerAPI:Open()
        content.Visible = true
        inline.Visible = true
        pickerAPI:FadeIn()
    end

    function pickerAPI:FadeIn()
        for _, obj in pairs(content:GetDescendants()) do
            if obj:IsA("Frame") then
                TweenService:Create(obj, TweenInfo.new(0.1), { BackgroundTransparency = 0 }):Play()
            elseif obj:IsA("TextButton") then
                TweenService:Create(obj, TweenInfo.new(0.1), { TextTransparency = 0 }):Play()
            end
        end
    end

    function pickerAPI:FadeOut()
        for _, obj in pairs(content:GetDescendants()) do
            if obj:IsA("Frame") then
                TweenService:Create(obj, TweenInfo.new(0.1), { BackgroundTransparency = 1 }):Play()
            elseif obj:IsA("TextButton") then
                TweenService:Create(obj, TweenInfo.new(0.1), { TextTransparency = 1 }):Play()
            end
        end
    end

    function pickerAPI:Close()
        pickerAPI:FadeOut()
        task.wait(0.05)
        content.Visible = false
        inline.Visible = false
    end

    function inner:UpdateList()
        if State.KeybindList and self.KeybindsList then
            State.KeybindList:Add(self.KeybindListName, inner.FMode)
            State.KeybindList:SetVisibility(self.KeybindListName, self:GetState())
            State.KeybindList:SetMode(self.KeybindListName, inner.FMode)
        end
    end

    function inner:Value(data)
        if data then
            if data[1] then
                local keyName = data[1]
                keyBtn.Text = "key : " .. ((keyName == "none" or keyName == "") and "none" or keyName)
                inner.FKey = keyName
            else
                keyBtn.Text = "key : none"
            end
            if data[2] and inner.Modes[data[2]] then
                inner.Modes[data[2]]:Click(data[2] == "Toggle" and true or false)
            end
            inner:UpdateList()
        end
        return inner
    end

    function self:GetState()
        if inner.FMode == "Always" then
            return true
        end
        if inner.FKey == "none" then
            return false
        end
        return inner.Toggled
    end

    for _, modeName in pairs({ "Toggle", "Hold", "Always" }) do
        local modeAPI = {}
        local modeBtn = new("TextButton", {
            Name = "KB_Button",
            Parent = content,
            BackgroundColor3 = color(21, 21, 21),
            BorderColor3 = color(34, 34, 160),
            BorderSizePixel = 0,
            Position = udim2(0, 0, 0.041, 0),
            Size = udim2(0, 68, 0, 14),
            AutoButtonColor = false,
            FontFace = Fonts.Default,
            Text = tostring(modeName),
            TextColor3 = color(129, 129, 127),
            TextSize = 12,
            ZIndex = 4
        })
        content.Size = content.Size + udim2(0, 0, 0, modeBtn.TextBounds.Y)

        function modeAPI:Click(_, skipCallback)
            for _, other in pairs(inner.Modes) do
                other:Unclick()
            end
            inner.FMode = modeName
            inline.Visible = false
            inner:UpdateList()
            modeBtn.TextColor3 = color(168, 157, 159)
            if not skipCallback then
                pcall(self.Callback, self:GetState())
            end
        end

        function modeAPI:Unclick()
            modeBtn.TextColor3 = color(129, 129, 127)
        end

        if modeName == inner.FMode then
            modeAPI:Click(true)
        end

        modeBtn.MouseButton1Down:Connect(function()
            modeAPI:Click()
        end)

        ThemeEvent.Event:Connect(function()
            if modeName == inner.FMode then
                modeBtn.TextColor3 = Theme.accent
            end
        end)

        inner.Modes[modeName] = modeAPI
    end

    keyBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            inner.Picking = true
            keyBtn.Text = ""
            task.wait(0.02)
            local conn
            conn = UserInputService.InputBegan:Connect(function(input2)
                local display = input2.KeyCode.Name == "Escape" and "none" or KeyNames[input2.KeyCode] or KeyNames[input2.UserInputType] or input2.KeyCode.Name
                if input2.UserInputType == Enum.UserInputType.Keyboard and input2.KeyCode.Name == "Escape" then
                    inner.FKey = "none"
                elseif input2.UserInputType == Enum.UserInputType.Keyboard then
                    inner.FKey = input2.KeyCode.Name
                elseif input2.UserInputType == Enum.UserInputType.MouseButton1 then
                    inner.FKey = "MB1"
                elseif input2.UserInputType == Enum.UserInputType.MouseButton2 then
                    inner.FKey = "MB2"
                end
                inner.Picking = false
                keyBtn.Text = "key : " .. display
                pcall(self.Callback, self:GetState())
                State.Flags[self.Flag] = self:GetState()
                State.Flags[self.Flag .. "_info"] = { inner.FKey, inner.FMode }
                inner:UpdateList()
                conn:Disconnect()
            end)
        end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            removePopupsChecked(frame.Name)
            if inline.Visible then
                pickerAPI:Close()
            else
                newPopup({ Remove = pickerAPI.Close, ID = frame.Name })
                pickerAPI:Open()
            end
        end
    end)

    UserInputService.InputBegan:Connect(function(input)
        if inner.Picking then
            return
        end
        local mouseType = inner.FKey == "MB2" and "MouseButton2" or inner.FKey == "MB1" and "MouseButton1"
        local resolved = mouseType
        if not resolved then
            resolved = inner.FKey == "MB3" and "MouseButton3"
        end
        if input.KeyCode.Name == inner.FKey or (resolved and input.UserInputType.Name == resolved) then
            if inner.FMode == "Toggle" then
                inner.Toggled = not inner.Toggled
            elseif inner.FMode == "Hold" then
                inner.Toggled = true
                local conn
                conn = UserInputService.InputEnded:Connect(function(input2)
                    if input2.KeyCode.Name == inner.FKey or (resolved and input2.UserInputType.Name == resolved) then
                        conn:Disconnect()
                        inner.Toggled = false
                        pcall(self.Callback, self:GetState())
                        inner:UpdateList()
                    end
                end)
            end
            pcall(self.Callback, self:GetState())
            State.Flags[self.Flag] = self:GetState()
            State.Flags[self.Flag .. "_info"] = { inner.FKey, inner.FMode }
            inner:UpdateList()
        end
    end)

    if inner.FKey ~= "" then
        inner:Value({ inner.FKey, inner.FMode })
    end

    State.Flags[self.Flag] = self:GetState()
    State.Flags[self.Flag .. "_info"] = { inner.FKey, inner.FMode }
    State.ConfigFlags[self.Flag .. "_info"] = function(value)
        inner:Value(value)
    end

    self.Instance = frame
    self.Inner = inner
    self.PickerAPI = pickerAPI
    self.Parent = parent
    return self
end

