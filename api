            Text = value,
            TextColor3 = color(129, 129, 127),
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4
        })

        objects.Name = name
        inline.Size = inline.Size + udim2(0, 0, 0, 22)

        local function click()
            name.TextColor3 = Theme.accent
            inner.FValues[value].Selected = true
        end

        local function unclick()
            name.TextColor3 = color(129, 129, 127)
            inner.FValues[value].Selected = false
        end

        btn.MouseButton1Down:Connect(function()
            inner:Set(value)
        end)

        inner.FValues[value] = {
            Click = click,
            Unclick = unclick,
            Objects = objects,
            Selected = false
        }

        ThemeEvent.Event:Connect(function()
            if inner.FValues[value] and inner.FValues[value].Selected then
                name.TextColor3 = Theme.accent
            end
        end)
        return inner
    end

    function inner:Update()
        for key, data in pairs(inner.FValues) do
            if inner.FValue == key then
                data.Click()
            else
                data.Unclick()
            end
        end
        return inner
    end

    function inner:Display()
        if self.Multi then
            local list = {}
            if #inner.FValue > 0 then
                for _, v in pairs(inner.FValue) do
                    table.insert(list, v)
                    text.Text = table.concat(list, ", ")
                end
            else
                text.Text = "-"
            end
        else
            text.Text = inner.FValue ~= "" and inner.FValue or "-"
        end
        return inner
    end

    function inner:Set(value)
        if self.Multi then
            if typeof(value) == "table" then
                table.clear(inner.FValue)
                for _, v in ipairs(value) do
                    table.insert(inner.FValue, v)
                end
                for key, data in pairs(inner.FValues) do
                    if table.find(inner.FValue, key) then
                        data.Click()
                    else
                        data.Unclick()
                    end
                end
                inner:Display()
                pcall(self.Callback, inner.FValue)
                State.Flags[self.Flag] = inner.FValue
                return inner
            end
            local index = table.find(inner.FValue, value)
            if index then
                table.remove(inner.FValue, index)
                inner:Display()
                if inner.FValues[value] then
                    inner.FValues[value].Unclick()
                end
            else
                if not inner.FValues[value] then
                    inner:Display()
                    return inner
                end
                table.insert(inner.FValue, value)
                inner:Display()
                inner.FValues[value].Click()
            end
            pcall(self.Callback, inner.FValue)
            State.Flags[self.Flag] = inner.FValue
        else
            inner.FValue = value
            inner:Update()
            inner:Display()
            pcall(self.Callback, inner.FValue)
            State.Flags[self.Flag] = inner.FValue
        end
        return inner
    end

    function inner:Refresh(values)
        for _, data in pairs(inner.FValues) do
            data.Objects.Name:Destroy()
        end
        inline.Size = udim2(0, 159, 0, 0)
        table.clear(inner.FValues)
        if self.Multi then
            table.clear(inner.FValue)
        else
            inner.FValue = nil
        end
        for _, v in pairs(values) do
            inner:CreateValue(v)
        end
        if self.Multi then
            inner:Display()
            pcall(self.Callback, inner.FValue)
            State.Flags[self.Flag] = inner.FValue
        else
            inner:Update()
            inner:Display()
            pcall(self.Callback, inner.FValue)
            State.Flags[self.Flag] = inner.FValue
        end
        inner:Set(self.Default)
        return inner
    end

    for _, value in pairs(self.Content) do
        inner:CreateValue(value)
    end
    inner:Set(self.Default)

    openButton.MouseButton1Click:Connect(function()
        removePopupsChecked(frame.Name)
        if inline.Visible then
            inlineAPI:Close()
            inline.ZIndex = 2
        else
            newPopup({ Remove = inlineAPI.Close, ID = frame.Name })
            inline.ZIndex = 4
            inlineAPI:Open()
        end
    end)

    State.ConfigFlags[self.Flag] = function(value)
        inner:Set(value)
    end

    self.Instance = frame
    self.Inner = inner
    self.DropdownAPI = inlineAPI
    self.Parent = parent
    return self, inner
end

