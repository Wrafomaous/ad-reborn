        onTween = TweenService:Create(status, TweenInfo.new(0.2), { BackgroundColor3 = Theme.accent })
        if self.State then
            status.BackgroundColor3 = Theme.accent
        end
    end)

    function self:Set(value)
        self.State = value
        pcall(self.Callback, self.State)
        State.Flags[self.Flag] = self.State
        if self.State then
            onTween:Play()
            onTextTween:Play()
        else
            offTween:Play()
            offTextTween:Play()
        end
    end

    btn.MouseButton1Click:Connect(function()
        self:Set(not self.State)
    end)

    self:Set(self.Default)
    State.ConfigFlags[self.Flag] = function(value)
        self:Set(value)
    end

    self.Instance = frame
    self.Frame = frame
    self.Parent = parent

    self.Keybind = function(_, keybindOptions)
        return Keybind.new(parent, keybindOptions, frame)
    end

    self.Colorpicker = function(_, cpOptions)
        return Colorpicker.new(parent, cpOptions, frame)
    end

    self.Settings = function(_, settingsOptions)
        if settingsOptions and settingsOptions.callback then
            pcall(settingsOptions.callback)
        end
        return self
    end

    return self
end

