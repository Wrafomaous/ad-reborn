            Color = color(24, 24, 24)
        })

        new("UICorner", { Name = "DBCorner", Parent = btn, CornerRadius = UDim.new(0, 3) })

        local name = new("TextLabel", {
            Name = "DBName",
            Parent = btn,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = udim2(0.013, 0, 0, 0),
            Size = udim2(0, 40, 1, 0),
