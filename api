function Button.new(parent, options)
    local self = setmetatable({}, Button)
    self.Title = options.title or "button"
    self.Callback = options.callback or function() end
    self.Flag = getNextFlag()

    local frame = new("Frame", {
        Name = "ButtonHolder",
        Parent = parent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = udim2(0, 159, 0, 23),
        ZIndex = 11
    })

    local btn = new("TextButton", {
        Name = "Button",
        Parent = frame,
        BackgroundColor3 = color(21, 21, 21),
        BorderColor3 = color(0, 0, 0),
        BorderSizePixel = 0,
        Size = udim2(1, 0, 1, 0),
        AutoButtonColor = false,
        FontFace = Fonts.Default,
        Text = self.Title,
        TextColor3 = color(255, 255, 255),
        TextSize = 12,
        TextStrokeTransparency = 0,
        TextWrapped = true,
        ZIndex = 11
    })

    new("UICorner", {
        Name = "ButtonCorner",
        Parent = btn,
        CornerRadius = UDim.new(0, 2)
    })

    new("UIStroke", {
        Name = "ButtonStroke",
        Parent = btn,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = color(37, 37, 37),
        ZIndex = 11
    })

    local hoverTween = TweenService:Create(btn, TweenInfo.new(0), { BackgroundColor3 = color(28, 28, 28) })
    local leaveTween = TweenService:Create(btn, TweenInfo.new(0), { BackgroundColor3 = color(21, 21, 21) })
    local clickTween = TweenService:Create(btn, TweenInfo.new(0), { BackgroundColor3 = color(36, 36, 36) })

    btn.MouseEnter:Connect(function()
        hoverTween:Play()
    end)

    btn.MouseLeave:Connect(function()
        leaveTween:Play()
    end)

    btn.MouseButton1Click:Connect(function()
        clickTween:Play()
        pcall(self.Callback)
        task.wait(0.1)
        hoverTween:Play()
    end)

    self.Instance = frame
    self.Button = btn
    self.Set = function(_, value)
        State.Flags[self.Flag] = value
    end
    State.ConfigFlags[self.Flag] = function(value)
        self:Set(value)
    end
    return self
end

