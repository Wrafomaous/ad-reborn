function Window:GetConfig()
    local config = {}
    for flag in pairs(State.ConfigFlags) do
        local value = State.Flags[flag]
        if typeof(value) == "EnumItem" then
            config[flag] = value
        elseif typeof(value) == "Color3" then
            config[flag] = { value:ToHex() }
        else
            config[flag] = value
        end
    end
    return HttpService:JSONEncode(config)
end

function Window:LoadConfig(json)
    local data = HttpService:JSONDecode(json)
    for flag, value in pairs(data) do
        local setter = State.ConfigFlags[flag]
        if setter then
            setter(value)
        end
    end
end

function Window:ToggleVisibility()
    if not self.Container or not self.Container.BackgroundFrame then
        return
    end
    local visible = not self.Container.BackgroundFrame.Visible
    self.Container.BackgroundFrame.Visible = visible
    if not visible then
        removePopups()
        for _, obj in ipairs(self.Container.ScreenGui:GetDescendants()) do
            if obj:IsA("GuiObject") and obj.Name == "InfoTooltip" then
                obj.Visible = false
            end
        end
    end
end

function Window:SetMenuKeybind(key)
    if self.MenuConnection then
        self.MenuConnection:Disconnect()
        self.MenuConnection = nil
    end
    if not key or key == "" or key == "none" then
        key = "RightShift"
    end
    self.MenuKey = key
    self.MenuConnection = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then
            return
        end
        local resolvedMouse = key == "MB2" and "MouseButton2" or key == "MB1" and "MouseButton1" or key == "MB3" and "MouseButton3"
        if input.KeyCode.Name == key or (resolvedMouse and input.UserInputType.Name == resolvedMouse) then
            self:ToggleVisibility()
        end
    end)
end

