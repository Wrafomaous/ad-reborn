local function lerp(a, b, t)
    return a + (b - a) * t
end

local function new(class, props)
    local instance = Instance.new(class)
    for k, v in pairs(props or {}) do
        instance[k] = v
    end
    return instance
end

local function udim2(xs, xo, ys, yo)
