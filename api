        ZIndex = 11
    })

    local inline = new("Frame", {
        Name = "SliderInline",
        Parent = frame,
        BackgroundColor3 = color(21, 21, 21),
        BorderColor3 = color(0, 0, 0),
        BorderSizePixel = 0,
        Position = udim2(0, 0, 0.55, 0),
        Size = udim2(1, 0, 0, 6),
        ZIndex = 11
    })

    new("UICorner", { Parent = inline, CornerRadius = UDim.new(0, 2), Name = "InlineCorner" })

    local background = new("Frame", {
        Name = "SliderBackground",
        Parent = inline,
        BackgroundColor3 = color(21, 21, 21),
        BorderColor3 = color(0, 0, 0),
        BorderSizePixel = 0,
        Size = udim2(1, 0, 1, 0),
        ZIndex = 11
    })

    new("UICorner", { Parent = background, CornerRadius = UDim.new(0, 2), Name = "BackgroundCorner" })

    local fill = new("Frame", {
        Name = "SliderFill",
        Parent = background,
        BackgroundColor3 = color(182, 153, 159),
        BorderSizePixel = 0,
        Size = udim2(0, 0, 1, 0),
        ZIndex = 11
    })

    new("UICorner", { Parent = fill, CornerRadius = UDim.new(0, 2), Name = "FillCorner" })

    local drag = new("Frame", {
        Name = "SliderDrag",
        Parent = frame,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = udim2(0, 0, 0.55, -5),
        Size = udim2(1, 0, 0, 16),
        ZIndex = 12
    })

    new("UICorner", { Parent = drag, CornerRadius = UDim.new(0, 2), Name = "DragCorner" })

    new("UIStroke", {
        Name = "INLINESTROKE",
        Parent = inline,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = color(32, 32, 32),
        ZIndex = 11
    })

    local backgroundStroke = new("UIStroke", {
        Name = "SliderBackgroundStroke",
        Parent = background,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = color(32, 32, 32),
        ZIndex = 11
    })

    local fillStroke = new("UIStroke", {
        Name = "SliderFillStroke",
        Parent = fill,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = color(172, 159, 159),
        Transparency = 0.5,
        ZIndex = 11
    })

    ThemeEvent.Event:Connect(function()
        fill.BackgroundColor3 = Theme.accent
        fillStroke.Color = Theme.accent
    end)

    function self:Set(value)
        local rounded = math.clamp(self.Float * math.round(value / self.Float), self.Min, self.Max)
        local ratio = (rounded - self.Min) / (self.Max - self.Min)
        self.Value = rounded
        TweenService:Create(fill, TweenInfo.new(0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = udim2(ratio, 0, 1, 0)
        }):Play()
        pcall(self.Callback, rounded)
        State.Flags[self.Flag] = self.Value
        if self.Value == self.Min then
            valueLabel.Text = self.MinText
        elseif self.Value == self.Max then
            valueLabel.Text = self.MaxText
        else
            valueLabel.Text = string.format("%.14g%s", self.Value, self.Suffix)
        end
    end

    function self:Slide(input)
        local ratio = math.clamp((self.Max - self.Min) * (input.Position.X - background.AbsolutePosition.X) / background.AbsoluteSize.X + self.Min, self.Min, self.Max)
        self:Set(ratio)
    end

    self:Set(self.Default)

    drag.MouseEnter:Connect(function()
        TweenService:Create(backgroundStroke, TweenInfo.new(0.2), { Color = color(255, 255, 255) }):Play()
    end)

    drag.MouseLeave:Connect(function()
        TweenService:Create(backgroundStroke, TweenInfo.new(0.2), { Color = color(32, 32, 32) }):Play()
    end)

    drag.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.Sliding = true
            self:Slide(input)
        end
    end)

    drag.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.Sliding = false
            self:Slide(input)
        end
    end)

    drag.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and self.Sliding then
            self:Slide(input)
        end
    end)

    State.ConfigFlags[self.Flag] = function(value)
        self:Set(value)
    end

    self.Instance = frame
    self.Parent = parent
    return self
end

