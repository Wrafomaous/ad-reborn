            Parent = CoreGui,
            BackgroundColor3 = color(15, 15, 15),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 10,
            AutomaticSize = Enum.AutomaticSize.XY
        })

        new("UICorner", { Parent = tooltip, CornerRadius = UDim.new(0, 4) })

        local tooltipStroke = new("UIStroke", {
            Parent = tooltip,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Color = color(37, 37, 37),
            Transparency = 1
        })

        new("UIPadding", {
            Parent = tooltip,
            PaddingLeft = UDim.new(0, 6),
            PaddingRight = UDim.new(0, 6),
            PaddingTop = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 4)
        })

        local tooltipLabel = new("TextLabel", {
            Parent = tooltip,
            BackgroundTransparency = 1,
            FontFace = Fonts.Default,
            Text = self.InfoText,
            TextColor3 = color(255, 255, 255),
            TextTransparency = 1,
            TextSize = 12,
            Size = udim2(0, 0, 0, 16),
            AutomaticSize = Enum.AutomaticSize.X,
            ZIndex = 2
        })

        local function updateTooltipPosition()
            local mouse = UserInputService:GetMouseLocation()
            tooltip.Position = udim2(0, mouse.X + 12, 0, mouse.Y - 28)
        end

        infoFrame.MouseEnter:Connect(function()
            tooltip.Visible = true
            updateTooltipPosition()
            TweenService:Create(tooltip, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
            TweenService:Create(tooltipStroke, TweenInfo.new(0.2), { Transparency = 0 }):Play()
            TweenService:Create(tooltipLabel, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
        end)

        infoFrame.MouseMoved:Connect(updateTooltipPosition)

        infoFrame.MouseLeave:Connect(function()
            TweenService:Create(tooltip, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(tooltipStroke, TweenInfo.new(0.2), { Transparency = 1 }):Play()
            TweenService:Create(tooltipLabel, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
            task.wait(0.2)
            tooltip.Visible = false
        end)
    end

